rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function driverPath(uid) {
      return /databases/$(database)/documents/drivers/$(uid);
    }

    function approvedDriver() {
      return signedIn()
        && exists(driverPath(request.auth.uid))
        && get(driverPath(request.auth.uid)).data.approved == true;
    }

    function baseFare(vehicleType) {
      return vehicleType == 'bike' ? 55
        : vehicleType == 'auto' ? 95
        : vehicleType == 'cab' ? 250
        : vehicleType == 'parcel' ? 75
        : -1;
    }

    function validRideFare(ride) {
      let base = baseFare(ride.vehicleType);
      return (ride.couponCode == '' && ride.fare == base)
        || (ride.couponCode in ['SOUTH50', 'ARIDE50'] && ride.fare == base - 25);
    }

    match /drivers/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, delete: if false;
      allow update: if signedIn()
        && request.auth.uid == uid
        && resource.data.approved == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['available', 'updatedAt'])
        && request.resource.data.available is bool;
    }

    match /rideRequests/{rideId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'customerUid', 'pickup', 'drop', 'pickupCoordinates', 'dropCoordinates',
          'vehicleType', 'fare', 'couponCode', 'paymentMethod', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == 'searching'
        && request.resource.data.pickup is string
        && request.resource.data.drop is string
        && request.resource.data.pickupCoordinates is map
        && request.resource.data.dropCoordinates is map
        && request.resource.data.vehicleType in ['bike', 'auto', 'cab', 'parcel']
        && request.resource.data.fare is int
        && validRideFare(request.resource.data)
        && request.resource.data.paymentMethod in ['online', 'cash']
        && request.resource.data.couponCode is string;

      allow get: if signedIn()
        && (resource.data.customerUid == request.auth.uid || approvedDriver());

      allow list: if approvedDriver()
        && get(driverPath(request.auth.uid)).data.available == true
        && (
          resource.data.status == 'searching'
          || resource.data.driverUid == request.auth.uid
        );

      allow update: if signedIn() && (
        (
          resource.data.customerUid == request.auth.uid
          && resource.data.status == 'searching'
          && request.resource.data.status == 'canceled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        )
        ||
        (
          approvedDriver()
          && get(driverPath(request.auth.uid)).data.available == true
          && resource.data.status == 'searching'
          && request.resource.data.status == 'accepted'
          && request.resource.data.driverUid == request.auth.uid
          && request.resource.data.driverName == get(driverPath(request.auth.uid)).data.name
          && request.resource.data.driverVehicle == get(driverPath(request.auth.uid)).data.vehicle
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'driverUid', 'driverName', 'driverVehicle', 'updatedAt'
          ])
        )
        ||
        (
          approvedDriver()
          && resource.data.driverUid == request.auth.uid
          && (
            (resource.data.status == 'accepted' && request.resource.data.status == 'arrived')
            || (resource.data.status == 'in_progress' && request.resource.data.status == 'completed')
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        )
        ||
        (
          approvedDriver()
          && resource.data.driverUid == request.auth.uid
          && resource.data.status in ['accepted', 'arrived', 'in_progress']
          && request.resource.data.status == resource.data.status
          && request.resource.data.driverLocation is map
          && request.resource.data.driverLocation.latitude is number
          && request.resource.data.driverLocation.longitude is number
          && request.resource.data.driverLocation.latitude >= 6
          && request.resource.data.driverLocation.latitude <= 38
          && request.resource.data.driverLocation.longitude >= 68
          && request.resource.data.driverLocation.longitude <= 98
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['driverLocation', 'updatedAt'])
        )
      );

      allow delete: if false;
    }

    match /emailOtpChallenges/{challengeId} {
      allow read, write: if false;
    }

    match /rideTripOtps/{rideId} {
      allow read, write: if false;
    }
  }
}
