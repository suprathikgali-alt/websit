        // Search India-wide using OpenStreetMap Nominatim.
        function handleLocationInput(type, query, isTyping) {
            let containerId = type === 'pickup' ? 'pickupSuggestions' : 'dropSuggestions';
            let container = document.getElementById(containerId);
            let requestId = ++locationSearchRequests[type];
            clearTimeout(locationSearchTimers[type]);
            if(isTyping) {
                revealLocationSearchSpace(type);
                if(type === 'pickup') appState.pickupCoordinates = null;
                else appState.dropCoordinates = null;
                updateBookingRoute();
            }

            if(!query || query.trim().length < 3) {
                container.classList.add('hidden');
                return;
            }

            let searchText = query.trim().toLocaleLowerCase();
            let cityResults = Object.entries(cityData).filter(function(entry) {
                return entry[0] !== 'india' &&
                    (entry[0].toLocaleLowerCase().includes(searchText) ||
                    entry[1].name.toLocaleLowerCase().includes(searchText));
            }).slice(0, 6);
            container.replaceChildren();
            cityResults.forEach(function(entry) {
                addLocationSearchOption(container, type, entry[1].name + ', India', entry[1].center);
            });
            let loadingRow = null;
            if(cityResults.length === 0) {
                loadingRow = document.createElement('div');
                loadingRow.className = 'px-4 py-3 text-xs text-gray-500';
                setLocalizedText(loadingRow, 'Searching Indian addresses…');
                container.appendChild(loadingRow);
            }
            container.classList.remove('hidden');
            locationSearchTimers[type] = setTimeout(async function() {
                try {
                    let params = new URLSearchParams({
                        format: 'jsonv2',
                        countrycodes: 'in',
                        limit: '6',
                        q: query.trim()
                    });
                    if(map) {
                        let bounds = map.getBounds();
                        params.set('viewbox', [
                            bounds.getWest(),
                            bounds.getNorth(),
                            bounds.getEast(),
                            bounds.getSouth()
                        ].join(','));
                        params.set('bounded', '0');
                    }
                    let url = 'https://nominatim.openstreetmap.org/search?' + params.toString();
                    let response = await fetch(url, { headers: { 'Accept': 'application/json' } });
                    if(!response.ok) throw new Error('Address search returned HTTP ' + response.status);
                    let results = await response.json();
                    if(requestId !== locationSearchRequests[type]) return;

                    if(loadingRow) loadingRow.remove();
                    if(!Array.isArray(results)) throw new Error('Address search returned an invalid response.');
                    if(results.length === 0 && cityResults.length === 0) {
                        setLocationSearchMessage(container, 'No Indian locations found. Try a city, road, or landmark.', false);
                        return;
                    }

                    results.forEach(function(result) {
                        let coordinates = [Number(result.lat), Number(result.lon)];
                        let duplicateCity = cityResults.some(function(entry) {
                            return entry[1].name.toLocaleLowerCase() === result.name?.toLocaleLowerCase();
                        });
                        if(!duplicateCity) {
                            addLocationSearchOption(container, type, result.display_name, coordinates);
                        }
                    });
                    if(results.length === 0 && cityResults.length > 0) {
                        appendLocationSearchMessage(container, 'No Indian locations found. Try a city, road, or landmark.', false);
                    }
                } catch(error) {
                    if(requestId !== locationSearchRequests[type]) return;
                    if(loadingRow) loadingRow.remove();
                    if(cityResults.length === 0) {
                        setLocationSearchMessage(container, 'Address search failed. Check your connection and try again.', true);
                    } else {
                        appendLocationSearchMessage(container, 'Address search failed. Check your connection and try again.', true);
                    }
                    console.error('India address search failed:', error);
                }
            }, 1000);
