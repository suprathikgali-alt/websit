            navigator.geolocation.getCurrentPosition(function(position) {
                let coordinates = [position.coords.latitude, position.coords.longitude];
                appState.pickupCoordinates = coordinates;
                appState.pickup = 'My current location';
                document.getElementById('pickupInput').value = appState.pickup;
                pickupMarker.setLatLng(coordinates).bindPopup('<b>My current location</b>');
                map.setView(coordinates, 16);
                updateBookingRoute();
                showToast('Pickup set to your current location.');
            }, function(error) {
                let message = error.code === error.PERMISSION_DENIED ? 'Allow location access to use your current position.' : 'Could not get your current location.';
                showToast(message);
            }, { enableHighAccuracy: true, timeout: 10000, maximumAge: 15000 });
        }

        function showIndiaMap() {
            if(map) map.fitBounds([[6.5, 68], [37.2, 97.5]], { padding: [20, 20] });
        }

        // Vehicle Selection
        function selectVehicle(type) {
            appState.vehicleType = type;
            document.querySelectorAll('.vehicle-tab').forEach(btn => {
                btn.classList.remove('border-arideGold', 'bg-yellow-50/60');
                btn.classList.add('border-gray-200', 'bg-white');
            });
            let selectedBtn = document.getElementById('v-' + type);
            selectedBtn.classList.add('border-arideGold', 'bg-yellow-50/60');
            selectedBtn.classList.remove('border-gray-200', 'bg-white');

            let names = { bike: 'Bike Taxi', auto: 'Auto', cab: 'Cab AC', parcel: 'Parcel Delivery' };
            let fares = { bike: {f: 55, o: 85, t: '4 mins'}, auto: {f: 95, o: 130, t: '6 mins'}, cab: {f: 250, o: 320, t: '10 mins'}, parcel: {f: 75, o: 100, t: '12 mins'} };

            let info = fares[type];
            appState.fare = info.f;
            appState.originalFare = info.o;
            appState.duration = info.t;

            setLocalizedText(document.getElementById('vehicleBadge'), names[type]);
            setLocalizedText(document.getElementById('btnVehicleName'), names[type]);
            document.getElementById('estFare').innerText = '₹' + info.f;
            document.getElementById('estOriginalFare').innerText = '₹' + info.o;
            setLocalizedText(document.getElementById('estDuration'), '⚡ ' + info.t + ' away on street');
        }

        // Payment Method Selection
        function selectPayment(method) {
            appState.paymentMethod = method;
            document.querySelectorAll('.pay-btn').forEach(btn => {
                btn.classList.remove('border-arideDark', 'bg-gray-50');
                btn.classList.add('border-gray-200', 'bg-white');
            });
            let btn = document.getElementById('pay-' + method);
            btn.classList.add('border-arideDark', 'bg-gray-50');
            btn.classList.remove('border-gray-200', 'bg-white');
        }

        // Apply Coupon Code
        function applyCoupon() {
            let code = document.getElementById('couponInput').value.trim().toUpperCase();
            if(code === 'SOUTH50' || code === 'ARIDE50') {
                if(!appState.couponApplied) {
                    appState.fare = Math.max(20, appState.fare - 25);
                    document.getElementById('estFare').innerText = '₹' + appState.fare;
                    document.getElementById('couponMessage').classList.remove('hidden');
                    appState.couponApplied = true;
                    showToast('South India Special Coupon applied! Saved ₹25.');
                } else {
                    showToast('Coupon already applied.');
                }
            } else {
                showToast('Invalid coupon code. Try SOUTH50');
            }
        }

        // Booking & Live Flow
        function startBooking() {
            appState.pickup = document.getElementById('pickupInput').value;
            appState.drop = document.getElementById('dropInput').value;
            if(!appState.pickupCoordinates || !appState.dropCoordinates) {
                showToast('Choose both pickup and drop from the India address search results.');
                return;
            }
            if(typeof window.io !== 'function') {
                showToast('Ride connection library did not load. Refresh and try again.');
                return;
            }

            document.getElementById('searchPickupName').innerText = appState.pickup;
            document.getElementById('summaryPickup').innerText = appState.pickup;
            document.getElementById('summaryDrop').innerText = appState.drop;
            document.getElementById('summaryFare').innerText = '₹' + appState.fare + ' (' + appState.paymentMethod.toUpperCase() + ')';

            document.querySelectorAll('.view-content').forEach(el => el.classList.add('hidden'));
            document.getElementById('view-searching').classList.remove('hidden');
            clearTimeout(bookingRequestTimer);
            let attemptId = ++bookingAttemptId;
            if(rideSocket) {
                rideSocket.disconnect();
                rideSocket = null;
            }
            rideSocket = window.io('http://localhost:5000');
            let rideRequested = false;

            function requestRide() {
                if(rideRequested || attemptId !== bookingAttemptId || !rideSocket || !rideSocket.connected) return;
                rideRequested = true;
                rideSocket.emit('request_ride', {
                    pickup: appState.pickup,
                    drop: appState.drop,
                    pickupCoordinates: appState.pickupCoordinates,
                    dropCoordinates: appState.dropCoordinates,
                    vehicleType: appState.vehicleType,
                    fare: '₹' + appState.fare
                });
                bookingRequestTimer = setTimeout(function() {
                    if(attemptId !== bookingAttemptId) return;
                    bookingAttemptId++;
                    rideSocket.disconnect();
                    rideSocket = null;
                    returnToBookingView();
                    showToast('Ride server did not respond. Please try again.');
                }, 12000);
            }

            rideSocket.once('connect', requestRide);
            rideSocket.once('connect_error', function(error) {
                if(attemptId !== bookingAttemptId) return;
                clearTimeout(bookingRequestTimer);
                bookingAttemptId++;
                rideSocket.disconnect();
                rideSocket = null;
                returnToBookingView();
                showToast('Could not connect to the ARIDE ride server.');
                console.error('ARIDE ride server connection failed:', error);
            });
            rideSocket.on('ride_accepted', function(response) {
                if(attemptId !== bookingAttemptId) return;
                clearTimeout(bookingRequestTimer);
                if(!response || response.success !== true || !response.captain) {
                    returnToBookingView();
                    showToast(response && response.message ? response.message : 'No captains are available right now.');
                    return;
                }
                assignCaptain(response.captain);
                if(response.captain.lat != null && response.captain.lng != null) {
                    handleCaptainLocationUpdate({
                        lat: response.captain.lat,
                        lng: response.captain.lng,
                        eta: response.eta
                    });
                }
                if(response.fare) document.getElementById('summaryFare').innerText = response.fare + ' (' + appState.paymentMethod.toUpperCase() + ')';
            });
            rideSocket.on('captain_location_update', function(location) {
                if(attemptId === bookingAttemptId) handleCaptainLocationUpdate(location);
            });
            rideSocket.on('ride_completed_or_arrived', function(result) {
                if(attemptId !== bookingAttemptId) return;
                clearTimeout(bookingRequestTimer);
                updateRiderGpsStatus('green', 'Captain has arrived at pickup', result && result.message ? result.message : 'Your captain has arrived.');
                showToast(result && result.message ? result.message : 'Your captain has arrived.');
            });
            rideSocket.on('disconnect', function(reason) {
                if(attemptId !== bookingAttemptId || reason === 'io client disconnect') return;
                updateRiderGpsStatus('red', 'Ride server disconnected', 'Live captain location updates stopped.');
            });
            if(rideSocket.connected) requestRide();
            else {
                bookingRequestTimer = setTimeout(function() {
                    if(attemptId !== bookingAttemptId) return;
                    bookingAttemptId++;
                    rideSocket.disconnect();
                    rideSocket = null;
                    returnToBookingView();
                    showToast('Could not connect to the ARIDE ride server.');
                }, 12000);
            }
        }

        function returnToBookingView() {
            document.querySelectorAll('.view-content').forEach(el => el.classList.add('hidden'));
            document.getElementById('view-home').classList.remove('hidden');
        }

        function cancelBooking() {
            bookingAttemptId++;
            clearTimeout(bookingRequestTimer);
            if(rideSocket) {
                rideSocket.emit('cancel_ride');
                rideSocket.disconnect();
                rideSocket = null;
            }
            switchTab('home');
            showToast('Booking cancelled.');
        }

        function assignCaptain(captain) {
            appState.captain = {
                ...appState.captain,
                name: captain.name || appState.captain.name,
                vehicleModel: captain.vehicle || appState.captain.vehicleModel,
                vehicleNo: captain.vehicleNo || appState.captain.vehicleNo
            };
            document.querySelectorAll('.view-content').forEach(el => el.classList.add('hidden'));
            document.getElementById('view-tracking').classList.remove('hidden');

            document.getElementById('captainName').innerText = appState.captain.name;
            document.getElementById('chatCaptainName').innerText = appState.captain.name;
            document.getElementById('callCaptainName').innerText = appState.captain.name;
            document.getElementById('captainVehicleModel').innerText = appState.captain.vehicleModel;
            if(captain.vehicleNo) document.getElementById('captainVehicleNo').innerText = captain.vehicleNo;

            if(!trackingMap) {
                trackingMap = L.map('trackingMap').setView(appState.pickupCoordinates, 14);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; OpenStreetMap contributors',
                    maxZoom: 19
                }).addTo(trackingMap);
            }
            updateRiderGpsStatus('amber', 'Captain GPS simulation: waiting for updates', 'Using the ARIDE demo ride server.');
            if(riderMarker) {
                trackingMap.removeLayer(riderMarker);
                riderMarker = null;
            }
            updateTrackingRoute();
            setTimeout(() => { trackingMap.invalidateSize(); }, 200);
            showToast(appState.captain.name + ' accepted your ride and is on the way.');
        }

        function updateRiderGpsStatus(state, title, help) {
            let colors = { amber: 'bg-amber-500', green: 'bg-green-500', red: 'bg-red-500' };
            let indicator = document.getElementById('riderGpsIndicator');
            indicator.className = 'w-2.5 h-2.5 rounded-full flex-shrink-0 ' + (colors[state] || colors.red);
            setLocalizedText(document.getElementById('riderGpsStatus'), title);
            setLocalizedText(document.getElementById('riderGpsHelp'), help);
        }

        function handleCaptainLocationUpdate(location) {
            let lat = Number(location && location.lat);
            let lng = Number(location && location.lng);
            if(!Number.isFinite(lat) || !Number.isFinite(lng) || lat < 6 || lat > 38 || lng < 68 || lng > 98) {
                updateRiderGpsStatus('red', 'Live captain GPS: invalid coordinates', 'The server sent a location outside India.');
                console.error('Rejected invalid captain GPS update:', location);
                return;
            }
            let coordinates = [lat, lng];
            if(!riderMarker) {
                riderMarker = L.marker(coordinates).addTo(trackingMap).bindPopup('Live captain location');
                trackingMap.setView(coordinates, 14);
            } else {
                riderMarker.setLatLng(coordinates);
            }
            let eta = location.eta ? 'ETA ' + location.eta + ' • ' : '';
            updateRiderGpsStatus('green', 'Demo captain location updating', eta + lat.toFixed(5) + ', ' + lng.toFixed(5));
        }

        function simulateRideComplete() {
            document.getElementById('ratedCaptainName').innerText = appState.captain.name;
            document.getElementById('ratingModal').classList.remove('hidden');
        }

        let selectedRatingStars = 5;
        let selectedTipAmount = 0;

        function setRating(stars) {
            selectedRatingStars = stars;
            let starBtns = document.querySelectorAll('.star-btn');
            starBtns.forEach((btn, index) => {
                if(index < stars) {
                    btn.classList.add('text-yellow-400');
                    btn.classList.remove('text-gray-300');
                } else {
                    btn.classList.remove('text-yellow-400');
                    btn.classList.add('text-gray-300');
                }
            });
        }

        function selectTip(amount) {
            selectedTipAmount = amount;
            document.querySelectorAll('.tip-btn').forEach(btn => {
                btn.classList.remove('border-arideDark', 'bg-yellow-50');
            });
            event.target.classList.add('border-arideDark', 'bg-yellow-50');
        }

        function submitRating() {
            document.getElementById('ratingModal').classList.add('hidden');
            ridesHistoryData.unshift({
                id: 'ARI-' + Math.floor(1000 + Math.random() * 9000),
                date: 'Just now',
                vehicle: 'Bike Taxi',
                from: appState.pickup,
                to: appState.drop,
                fare: '₹' + (appState.fare + selectedTipAmount),
                status: 'Completed'
            });
            renderRidesHistory();
            switchTab('home');
            showToast('Ride completed successfully.');
        }

        function buyPass(passName, price) {
            showToast('Successfully purchased ' + passName + ' for ₹' + price + '!');
        }

        function addCoins(amount) {
            appState.walletCoins += amount;
            document.getElementById('walletCoinsHeader').innerText = appState.walletCoins;
            setLocalizedText(document.getElementById('walletDisplayCoins'), appState.walletCoins + ' Coins');
            showToast('Added ₹' + amount + ' bonus coins to wallet!');
        }

        function renderRidesHistory() {
            let container = document.getElementById('ridesHistoryList');
            container.innerHTML = '';
            ridesHistoryData.forEach(ride => {
                let div = document.createElement('div');
                div.className = 'bg-white p-5 rounded-3xl shadow-md border border-gray-100 flex flex-col md:flex-row justify-between items-start md:items-center gap-4';
                div.innerHTML = `
                    <div>
                        <div class="flex items-center space-x-2 mb-1">
                            <span class="bg-yellow-100 text-yellow-800 text-[10px] font-extrabold px-2.5 py-0.5 rounded-full">${ride.vehicle}</span>
                            <span class="text-xs text-gray-400">${ride.id} • ${ride.date}</span>
                        </div>
                        <h4 class="text-sm font-bold text-gray-900">${ride.from} ➔ ${ride.to}</h4>
                    </div>
                    <div class="flex items-center space-x-4 w-full md:w-auto justify-between md:justify-end">
                        <div class="text-right">
                            <span class="text-base font-extrabold text-gray-900 block">${ride.fare}</span>
                            <span class="text-[10px] text-green-600 font-bold">${ride.status}</span>
                        </div>
                        <button onclick="switchTab('home')" class="bg-gray-100 hover:bg-arideGold text-gray-800 font-bold px-4 py-2 rounded-xl text-xs transition">
                            Rebook
                        </button>
                    </div>
                `;
                container.appendChild(div);
            });
        }

        function openChatModal() { document.getElementById('chatModal').classList.remove('hidden'); }
        function closeChatModal() { document.getElementById('chatModal').classList.add('hidden'); }
        function openCallModal() { document.getElementById('callModal').classList.remove('hidden'); }
        function closeCallModal() { document.getElementById('callModal').classList.add('hidden'); }

        function sendChatMessage() {
            let input = document.getElementById('chatInput');
            if(!input.value.trim()) return;
            let chatBox = document.getElementById('chatMessages');
            let msg = document.createElement('div');
            msg.className = 'bg-arideGold text-arideDark p-3 rounded-2xl shadow-sm text-xs max-w-[80%] ml-auto font-medium';
            msg.innerText = input.value;
            chatBox.appendChild(msg);
            input.value = '';
            chatBox.scrollTop = chatBox.scrollHeight;

            setTimeout(() => {
                let reply = document.createElement('div');
                reply.className = 'bg-white p-3 rounded-2xl shadow-sm text-xs max-w-[80%] font-medium';
                reply.innerText = 'Got it sir, waiting near the street entrance!';
                chatBox.appendChild(reply);
                chatBox.scrollTop = chatBox.scrollHeight;
            }, 1200);
        }

        function openSosModal() { document.getElementById('sosModal').classList.remove('hidden'); }
        function closeSosModal() { document.getElementById('sosModal').classList.add('hidden'); }
        function triggerSosAction(type) {
            closeSosModal();
            showToast('EMERGENCY SOS ALERT dispatched to ' + (type === 'police' ? 'Police (112)' : 'ARIDE Safety Team') + '!');
        }

        function copyReferral() {
            showToast('Referral code copied to clipboard!');
        }

        function showToast(message) {
            let toast = document.getElementById('toastNotification');
            setLocalizedText(document.getElementById('toastMessage'), message);
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3500);
        }
    </script>
</body>
</html>
