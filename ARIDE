        function localizeText(value) {
            if(typeof value !== 'string' || activeLanguage === 'en') return value;
            let dictionary = translations[activeLanguage];
            let trimmed = value.trim();
            if(dictionary[trimmed]) return value.replace(trimmed, dictionary[trimmed]);

            let match = trimmed.match(/^Switched to (.+) successfully\.$/);
            if(match) return dictionary['Switched to '] + match[1] + dictionary[' successfully.'];

            match = trimmed.match(/^Successfully purchased (.+) for ₹(\d+)!$/);
            if(match) return dictionary['Successfully purchased '] + localizeText(match[1]) + dictionary[' for ₹'] + match[2] + '!';

            match = trimmed.match(/^Added ₹(\d+)( bonus coins to wallet!)$/);
            if(match) return dictionary['Added ₹'] + match[1] + dictionary[match[2]];

            match = trimmed.match(/^(\d+) Coins$/);
            if(match) return match[1] + ' ' + dictionary.Coins;

            match = trimmed.match(/^Live rider GPS: updated (.+)$/);
            if(match) return dictionary['Live rider GPS: updated'] + ' ' + match[1];

            match = trimmed.match(/^EMERGENCY SOS ALERT dispatched to (.+)!$/);
            if(match) return dictionary['EMERGENCY SOS ALERT dispatched to ' + match[1] + '!'] || value;

            return value;
        }

        function translateTextNode(node) {
            let currentText = node.nodeValue;
            let originalText = originalTextNodes.get(node);
            if(originalText === undefined || (lastTranslatedTextNodes.has(node) && currentText !== lastTranslatedTextNodes.get(node))) {
                originalText = currentText;
                originalTextNodes.set(node, originalText);
            }
            let translatedText = localizeText(originalText);
            lastTranslatedTextNodes.set(node, translatedText);
            if(currentText !== translatedText) node.nodeValue = translatedText;
        }

        function translateElementAttributes(element) {
            ['placeholder', 'title', 'aria-label', 'alt'].forEach(function(attributeName) {
                if(!element.hasAttribute(attributeName)) return;
                let originals = originalAttributes.get(element) || {};
                let currentValue = element.getAttribute(attributeName);
                if(originals[attributeName] === undefined) originals[attributeName] = currentValue;
                let translatedValue = localizeText(originals[attributeName]);
                if(currentValue !== translatedValue) element.setAttribute(attributeName, translatedValue);
                originalAttributes.set(element, originals);
            });
        }

        function setLocalizedText(element, sourceText) {
            element.textContent = sourceText;
            let textNode = element.firstChild;
            if(!textNode || textNode.nodeType !== Node.TEXT_NODE) return;
            originalTextNodes.set(textNode, sourceText);
            let translatedText = localizeText(sourceText);
            lastTranslatedTextNodes.set(textNode, translatedText);
            if(textNode.nodeValue !== translatedText) textNode.nodeValue = translatedText;
        }

        function translateSubtree(root) {
            if(root.nodeType === Node.TEXT_NODE) {
                if(!root.parentElement || !root.parentElement.closest('script, style, noscript')) translateTextNode(root);
                return;
            }
            if(root.nodeType !== Node.ELEMENT_NODE && root !== document.body) return;
            if(root.nodeType === Node.ELEMENT_NODE) translateElementAttributes(root);
            let walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
            while(walker.nextNode()) {
                let textNode = walker.currentNode;
                if(!textNode.parentElement.closest('script, style, noscript')) translateTextNode(textNode);
            }
            if(root.querySelectorAll) root.querySelectorAll('[placeholder], [title], [aria-label], [alt]').forEach(translateElementAttributes);
        }

        function applyLanguageToPage() {
            translateSubtree(document.body);
            if(!languageObserver) {
                languageObserver = new MutationObserver(function(mutations) {
                    mutations.forEach(function(mutation) {
                        if(mutation.type === 'characterData') {
                            if(mutation.target.parentElement && !mutation.target.parentElement.closest('script, style, noscript')) translateTextNode(mutation.target);
                        } else {
                            mutation.addedNodes.forEach(translateSubtree);
                        }
                    });
                });
                languageObserver.observe(document.body, { subtree: true, childList: true, characterData: true });
            }
        }

