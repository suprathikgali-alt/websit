        async function getRoadRoute(from, to, requestId, isTracking) {
            let routeUrl = 'https://router.project-osrm.org/route/v1/driving/' +
                from[1] + ',' + from[0] + ';' + to[1] + ',' + to[0] +
                '?overview=full&geometries=geojson';
            let response = await fetch(routeUrl);
            if(!response.ok) throw new Error('Road routing returned HTTP ' + response.status);
            let data = await response.json();
            if(data.code !== 'Ok' || !data.routes || !data.routes.length) {
                throw new Error('No drivable road route was returned.');
            }
            if(requestId !== (isTracking ? trackingRouteRequestId : bookingRouteRequestId)) return;

            let routeCoordinates = data.routes[0].geometry.coordinates.map(function(point) {
                return [point[1], point[0]];
            });
            let targetMap = isTracking ? trackingMap : map;
            let oldLine = isTracking ? trackingRouteLine : bookingRouteLine;
            if(oldLine) targetMap.removeLayer(oldLine);
            let newLine = L.polyline(routeCoordinates, {
                color: '#A4863D',
                weight: 6,
                opacity: 0.9,
                lineCap: 'round',
                lineJoin: 'round'
            }).addTo(targetMap);
            if(isTracking) trackingRouteLine = newLine;
            else bookingRouteLine = newLine;

            return { routeLine: newLine, bounds: newLine.getBounds(), distance: data.routes[0].distance };
        }

        async function updateBookingRoute() {
            let requestId = ++bookingRouteRequestId;
            if(!appState.pickupCoordinates || !appState.dropCoordinates) {
                if(bookingRouteLine) {
                    map.removeLayer(bookingRouteLine);
                    bookingRouteLine = null;
                }
                return;
            }
            if(bookingRouteLine) {
                map.removeLayer(bookingRouteLine);
                bookingRouteLine = null;
            }
            try {
                await getRoadRoute(appState.pickupCoordinates, appState.dropCoordinates, requestId, false);
            } catch(error) {
                if(requestId !== bookingRouteRequestId) return;
                showToast('Road route unavailable. Please try again shortly.');
                console.error('Road route lookup failed:', error);
            }
        }

        async function updateTrackingRoute() {
            let requestId = ++trackingRouteRequestId;
            if(!appState.pickupCoordinates || !appState.dropCoordinates) return;
            if(trackingRouteLine) {
                trackingMap.removeLayer(trackingRouteLine);
                trackingRouteLine = null;
            }
            try {
                let route = await getRoadRoute(appState.pickupCoordinates, appState.dropCoordinates, requestId, true);
                if(route && requestId === trackingRouteRequestId) {
                    trackingMap.fitBounds(route.bounds, { padding: [50, 50], maxZoom: 16 });
                }
            } catch(error) {
                if(requestId !== trackingRouteRequestId) return;
                console.error('Tracking road route lookup failed:', error);
                document.getElementById('riderGpsHelp').textContent = 'Road route unavailable; rider GPS will still appear when connected.';
            }
        }

        function recenterMap() {
