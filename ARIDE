    <style>
        #map, #trackingMap {
            width: 100%;
            height: 100%;
            z-index: 10;
        }
        @media (max-width: 1023px) {
            #view-home, #view-tracking {
                flex-direction: column;
                overflow-y: auto;
            }
            #view-home > div:first-child {
                height: 58%;
                flex: 0 0 58%;
            }
            #view-home > div:last-child {
                height: 42%;
                min-height: 220px;
                flex: 1 0 42%;
            }
            #view-home > div:last-child #map {
                min-height: 220px;
            }
            #view-tracking > div:first-child {
                height: 58%;
                flex: 0 0 58%;
            }
            #view-tracking > div:last-child {
                height: 42%;
                min-height: 220px;
                flex: 1 0 42%;
            }
            #view-tracking > div:last-child #trackingMap {
                min-height: 220px;
            }
        }
        .pulse-ring {
            box-shadow: 0 0 0 0 rgba(164, 134, 61, 0.7);
            animation: pulse-animation 2s infinite;
        }
        @keyframes pulse-animation {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(164, 134, 61, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 20px rgba(164, 134, 61, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(164, 134, 61, 0); }
        }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        :root {
            --aride-forest: #0E300E;
            --aride-gold: #A4863D;
            --aride-charcoal: #333333;
            --aride-lavender: #E6E6FA;
            --aride-light-yellow: #FFF4CC;
            --aride-navy: #101B3F;
        }
        body {
            background-color: var(--aride-lavender);
            color: var(--aride-charcoal);
        }
        body.bg-gray-100 {
            background-color: var(--aride-lavender) !important;
        }
        [class~="bg-arideDark"], [class~="bg-arideGray"] {
            background-color: var(--aride-forest) !important;
        }
        [class~="bg-arideGold"], [class~="hover:bg-arideGold"]:hover,
        [class~="hover:bg-yellow-400"]:hover {
            background-color: var(--aride-gold) !important;
        }
        [class~="bg-gray-50"], [class~="bg-gray-100"], [class~="bg-gray-200"],
        [class~="bg-yellow-50"], [class~="bg-yellow-50/60"], [class~="bg-yellow-100"],
        [class~="bg-yellow-200"], [class~="bg-green-50"], [class~="bg-green-100"],
        [class~="bg-blue-100"], [class~="bg-amber-500"] {
            background-color: var(--aride-lavender) !important;
        }
        [class~="bg-gray-900"], [class~="bg-gray-800"], [class~="bg-gray-700"],
        [class~="bg-green-500"] {
            background-color: var(--aride-forest) !important;
        }
        [class~="hover:bg-gray-100"]:hover, [class~="hover:bg-gray-200"]:hover,
        [class~="hover:bg-gray-300"]:hover {
            background-color: var(--aride-lavender) !important;
        }
        [class~="hover:bg-black"]:hover {
            background-color: var(--aride-forest) !important;
        }
        [class~="text-arideDark"], [class~="text-gray-300"], [class~="text-gray-400"],
        [class~="text-gray-500"], [class~="text-gray-600"],
        [class~="text-gray-700"], [class~="text-gray-800"], [class~="text-gray-900"],
        [class~="text-yellow-600"], [class~="text-yellow-700"], [class~="text-yellow-800"],
        [class~="text-blue-800"], [class~="text-green-600"], [class~="text-green-700"],
        [class~="text-green-400"], [class~="text-green-800"] {
            color: var(--aride-charcoal) !important;
        }
        [class~="text-red-100"] {
            color: var(--aride-lavender) !important;
        }
        [class~="text-arideGold"] {
            color: var(--aride-forest) !important;
        }
        [class~="bg-arideGold"][class~="text-arideDark"] {
            color: var(--aride-forest) !important;
        }
        [class~="text-yellow-400"] {
            color: var(--aride-gold) !important;
        }
        [class~="bg-arideDark"] [class~="text-arideGold"],
        [class~="bg-arideDark"][class~="text-arideGold"],
        [class~="bg-arideGray"] [class~="text-arideGold"],
        [class~="bg-arideGray"][class~="text-arideGold"],
        [class~="bg-gray-900"][class~="text-arideGold"],
        .bg-arideDark [class~="text-gray-300"], .bg-arideDark [class~="text-gray-400"],
        .bg-arideDark [class~="text-green-400"],
        .bg-arideGray [class~="text-gray-300"], .bg-arideGray [class~="text-gray-400"],
        .bg-arideGray [class~="text-green-400"],
        header [class~="text-arideGold"] {
            color: var(--aride-lavender) !important;
        }
        header .nav-btn.text-arideGold {
            text-decoration: underline;
            text-decoration-color: var(--aride-gold);
            text-underline-offset: 5px;
        }
        #citySelector, #mobileCitySelector {
            color: var(--aride-forest) !important;
            background-color: var(--aride-lavender) !important;
            border-color: var(--aride-gold) !important;
        }
        [class~="border-arideDark"], [class~="hover:border-arideDark"]:hover,
        [class~="border-gray-700"], [class~="border-gray-800"] {
            border-color: var(--aride-forest) !important;
        }
        [class~="border-gray-100"], [class~="border-gray-200"],
        [class~="border-gray-300"], [class~="border-gray-400"],
        [class~="border-green-200"], [class~="border-yellow-200"],
        [class~="border-yellow-300"], [class~="hover:border-gray-300"]:hover {
            border-color: rgba(51, 51, 51, 0.2) !important;
        }
        [class~="from-yellow-50"] {
            --tw-gradient-from: var(--aride-lavender) var(--tw-gradient-from-position);
            --tw-gradient-to: rgb(230 230 250 / 0) var(--tw-gradient-to-position);
        }
        [class~="to-amber-100/50"] {
            --tw-gradient-to: rgb(164 134 61 / 0.18) var(--tw-gradient-to-position);
        }
        [class~="hover:text-arideGold"]:hover {
            color: var(--aride-lavender) !important;
        }
        [class~="hover:text-gray-800"]:hover {
            color: var(--aride-charcoal) !important;
        }
        [class~="hover:bg-red-50"]:hover {
            background-color: var(--aride-lavender) !important;
        }
        [class~="hover:border-arideDark"]:hover {
            border-color: var(--aride-forest) !important;
        }
        ::-webkit-scrollbar-track { background: var(--aride-lavender); }
        ::-webkit-scrollbar-thumb { background: var(--aride-forest); }
        ::-webkit-scrollbar-thumb:hover { background: var(--aride-gold); }
        header.bg-arideDark {
            background-color: var(--aride-light-yellow) !important;
            color: var(--aride-forest);
        }
        header.bg-arideDark [class~="text-arideGold"] {
            color: var(--aride-forest) !important;
        }
        header.bg-arideDark .nav-btn.text-gray-300 {
            color: var(--aride-forest) !important;
        }
        header.bg-arideDark .nav-btn.text-arideGold {
            color: var(--aride-forest) !important;
            text-decoration-color: var(--aride-gold);
        }
        header span.bg-gray-900 {
            background-color: var(--aride-lavender) !important;
            border-color: var(--aride-gold) !important;
        }
        header #langSelector {
            background-color: var(--aride-lavender) !important;
            color: var(--aride-forest) !important;
            border-color: var(--aride-gold) !important;
        }
        header.bg-arideDark {
            background-color: #000000 !important;
            color: #FFFFFF;
        }
        header.bg-arideDark > div:first-child > div.bg-arideGold {
            background-color: var(--aride-navy) !important;
            color: #FFFFFF !important;
        }
        header.bg-arideDark nav {
            background-color: var(--aride-navy);
            border-radius: 0.75rem;
            padding: 0.65rem 0.85rem;
        }
        header.bg-arideDark nav .nav-btn.text-gray-300 {
            color: var(--aride-lavender) !important;
        }
        header.bg-arideDark nav .nav-btn.text-arideGold {
            color: var(--aride-gold) !important;
        }
        body > div[class~="lg:hidden"][class~="bg-arideDark"] {
            background-color: var(--aride-navy) !important;
            border-color: var(--aride-navy) !important;
        }
        body > div[class~="lg:hidden"][class~="bg-arideDark"] .mobile-nav.text-gray-400 {
            color: var(--aride-lavender) !important;
        }
        body > div[class~="lg:hidden"][class~="bg-arideDark"] .mobile-nav.text-arideGold {
            color: var(--aride-gold) !important;
        }
        .leaflet-bar a {
            color: var(--aride-forest) !important;
            background-color: var(--aride-lavender) !important;
        }
        .leaflet-bar a:hover {
            color: var(--aride-forest) !important;
            background-color: var(--aride-gold) !important;
        }
        .leaflet-control-attribution {
            background-color: rgba(230, 230, 250, 0.9) !important;
            color: var(--aride-charcoal) !important;
        }
        .leaflet-control-attribution a {
            color: var(--aride-forest) !important;
        }
    </style>
</head>
