    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        arideGold: '#A4863D',
                        arideDark: '#0E300E',
                        arideGray: '#0E300E',
                        arideLight: '#E6E6FA'
                    },
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif']
                    }
                }
            }
        }
